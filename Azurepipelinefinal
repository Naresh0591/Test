trigger:
  branches:
    include:
      - main

stages:
- stage: ParallelBuild
  displayName: Parallel Build Stage
  jobs:
  - job: DotNetSolutionBuild
    displayName: .NET Solution Build
    pool:
      vmImage: ubuntu-latest
    workspace:
      clean: all
    steps:
    # Early Disk Space Check
    - script: |
        echo "=== INITIAL DISK USAGE ==="
        df -h /home/vsts/work/
        AVAILABLE=$(df --output=avail -k /home/vsts/work/ | tail -1)
        THRESHOLD=$((10 * 1024 * 1024)) # 10 GB in KB
        if [ "$AVAILABLE" -lt "$THRESHOLD" ]; then
          echo "❌ Not enough disk space. Exiting."
          exit 1
        fi
      displayName: "Check Disk Space Before Build"

    # Checkout source code
    - checkout: self
      clean: true
      fetchDepth: 1

    - script: |
        echo "=== Disk usage before cleanup ==="
        df -h /

        echo "Removing unused pre-installed toolchains to free disk space..."
        sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc /opt/hostedtoolcache/CodeQL 2>/dev/null || true
        sudo rm -rf /usr/local/share/boost /usr/local/graalvm /usr/local/.ghcup 2>/dev/null || true
        sudo docker system prune -af 2>/dev/null || true
        sudo apt-get clean 2>/dev/null || true

        echo "=== Disk usage after cleanup ==="
        df -h /
      displayName: Free Up Agent Disk Space

    - task: UseDotNet@2
      displayName: Install .NET SDK
      inputs:
        packageType: sdk
        version: '8.0.x'
        includePreviewVersions: true

    - task: UseDotNet@2
      displayName: Install .NET 10 SDK
      inputs:
        packageType: sdk
        version: '10.0.x'
        includePreviewVersions: true

    - task: UseDotNet@2
      displayName: Install .NET 9 Runtime (required by Paket 10.x)
      inputs:
        packageType: runtime
        version: '9.0.x'

    # Sanitize invisible/non-standard whitespace in source (build workspace only, repo untouched)
    - script: |
        echo "Sanitizing invisible/non-standard whitespace characters in .cs files (build workspace only, repo untouched)..."
        find "$(Build.SourcesDirectory)/CRMnext" -name "*.cs" -print0 | xargs -0 -I{} \
          perl -i -pe '
            s/\xC2\xA0/ /g;       # UTF-8 encoded non-breaking space
            s/\xA0/ /g;           # Latin-1/Windows-1252 encoded non-breaking space
            s/\xE2\x80\x8B//g;    # UTF-8 zero-width space
            s/\xEF\xBB\xBF//g;    # UTF-8 BOM
            s/\xE2\x80\xA8/\n/g;  # UTF-8 line separator
            s/\xE2\x80\xA9/\n\n/g;# UTF-8 paragraph separator
            s/\xE2\x80\x87/ /g;   # UTF-8 figure space
            s/\xE2\x80\xAF/ /g;   # UTF-8 narrow no-break space
          ' {}
        echo "Sanitization complete."
      displayName: Sanitize Invisible Characters (Build Workspace Only)

    # Fix case-sensitivity mismatch for Acidaes.Integration.BLL/Bll (build workspace only, repo untouched)
    - script: |
        echo "Creating case-insensitive symlink for Acidaes.Integration.BLL/Bll mismatch..."
        ACTUAL_DIR=$(find "$(Build.SourcesDirectory)/CRMnext/Integration" -maxdepth 1 -iname "Acidaes.Integration.Bll" | head -n 1)
        if [ -n "$ACTUAL_DIR" ]; then
          echo "Found actual directory: $ACTUAL_DIR"
          PARENT_DIR=$(dirname "$ACTUAL_DIR")
          ACTUAL_NAME=$(basename "$ACTUAL_DIR")
          for VARIANT in "Acidaes.Integration.BLL" "Acidaes.Integration.Bll" "Acidaes.Integration.bll"; do
            if [ "$VARIANT" != "$ACTUAL_NAME" ] && [ ! -e "$PARENT_DIR/$VARIANT" ]; then
              ln -s "$ACTUAL_NAME" "$PARENT_DIR/$VARIANT"
              echo "Created symlink: $VARIANT -> $ACTUAL_NAME"
            fi
          done
        else
          echo "⚠️ Could not locate Acidaes.Integration.Bll directory — skipping symlink creation."
        fi
      displayName: Fix Case-Sensitivity Symlink (Integration.BLL)

    # Aggressive Pre-Build Cleanup
    - script: |
        dotnet nuget locals all --clear
        rm -rf ~/.nuget/packages/* ~/.local/share/NuGet/* $(Agent.TempDirectory)/*
        find . -type d \( -name bin -o -name obj \) -exec rm -rf {} +
        echo "=== DISK USAGE AFTER INITIAL CLEANUP ==="
        df -h /home/vsts/work/
      displayName: Aggressive Pre-Build Cleanup

    - task: NuGetAuthenticate@1
      displayName: Authenticate to Azure Artifacts

    - script: |
        set -e
        PAKET_VERSION="10.3.1"
        PAKET_DIR="$(Build.SourcesDirectory)/CRMnext/.paket"

        echo "Downloading Paket $PAKET_VERSION nupkg directly from nuget.org (bypassing dotnet tool install)..."
        mkdir -p "$PAKET_DIR"
        curl -sSL -o /tmp/paket.nupkg \
          "https://api.nuget.org/v3-flatcontainer/paket/${PAKET_VERSION}/paket.${PAKET_VERSION}.nupkg"

        echo "Extracting package..."
        mkdir -p /tmp/paket-extracted
        unzip -q /tmp/paket.nupkg -d /tmp/paket-extracted

        echo "Locating paket.dll..."
        PAKET_DLL=$(find /tmp/paket-extracted/tools -name "paket.dll" | head -n 1)

        if [ -z "$PAKET_DLL" ]; then
          echo "❌ Could not find paket.dll inside the package. Listing contents for debugging:"
          find /tmp/paket-extracted -maxdepth 4
          exit 1
        fi

        echo "Found: $PAKET_DLL"
        cp -r "$(dirname "$PAKET_DLL")/." "$PAKET_DIR/"

        echo "Creating wrapper script..."
        cat > "$PAKET_DIR/paket" << 'WRAPPER_EOF'
        #!/usr/bin/env bash
        DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        exec dotnet "$DIR/paket.dll" "$@"
        WRAPPER_EOF
        chmod +x "$PAKET_DIR/paket"

        echo "Verifying installation..."
        "$PAKET_DIR/paket" --version

        echo "Authenticating to Azure Artifacts feed..."
        "$PAKET_DIR/paket" config add-credentials \
          "https://pkgs.dev.azure.com/acidaes/_packaging/acidaes/nuget/v3/index.json" \
          --username Azurepipelinetest2 \
          --password xyz
      displayName: Install & Authenticate Paket

    # Build SQL
    - script: |
        set -e
        for i in 1 2 3; do
          if dotnet build CRMnext/CRMnext_2019_Full.sln \
              --configuration Release \
              --configfile CRMnext/nuget.config \
              /p:Platform="Any CPU"; then
            break
          fi
          echo "Build attempt $i failed, retrying in 15s..."
          sleep 15
          if [ "$i" -eq 3 ]; then exit 1; fi
        done
      displayName: Build SQL Solution

    # Cleanup after SQL build
    - script: |
        chmod +x CRMnext/Clean.sh && ./CRMnext/Clean.sh
        dotnet nuget locals all --clear
        rm -rf $(Agent.TempDirectory)/*
        df -h /home/vsts/work/
      displayName: Cleanup After SQL Build

    # Build Oracle
    - script: |
        set -e
        for i in 1 2 3; do
          if dotnet build CRMnext/CRMnext_2019_Full-Oracle.sln \
              --configuration Release \
              --configfile CRMnext/nuget.config \
              /p:Platform="Any CPU"; then
            break
          fi
          echo "Build attempt $i failed, retrying in 15s..."
          sleep 15
          if [ "$i" -eq 3 ]; then exit 1; fi
        done
      displayName: Build Oracle Solution

    - script: |
        chmod +x CRMnext/Clean.sh && ./CRMnext/Clean.sh
        dotnet nuget locals all --clear
        rm -rf $(Agent.TempDirectory)/*
        df -h /home/vsts/work/
      displayName: Cleanup After Oracle Build

    # Build NpgSQL
    - script: |
        set -e
        for i in 1 2 3; do
          if dotnet build CRMnext/CRMnext_2019_Full-NpgSql.sln \
              --configuration Release \
              --configfile CRMnext/nuget.config \
              /p:Platform="Any CPU"; then
            break
          fi
          echo "Build attempt $i failed, retrying in 15s..."
          sleep 15
          if [ "$i" -eq 3 ]; then exit 1; fi
        done
      displayName: Build NpgSQL Solution

    - script: |
        chmod +x CRMnext/Clean.sh && ./CRMnext/Clean.sh
        dotnet nuget locals all --clear
        rm -rf $(Agent.TempDirectory)/*
        df -h /home/vsts/work/
      displayName: Cleanup After NpgSQL Build

    - script: |
        echo "=== FINAL DISK USAGE ==="
        df -h /home/vsts/work/
        echo "=== AGENT TEMP DIRECTORY USAGE ==="
        du -sh $(Agent.TempDirectory) || true
      displayName: Final Disk Usage Report

  - job: BuildJSAndCSS
    displayName: "JS & CSS Compilation"
    pool:
      vmImage: ubuntu-latest
    workspace:
      clean: all
    steps:
    # ✅ Re-enabled checkout
    - checkout: self
      clean: true
      fetchDepth: 1

    - task: UseNode@1
      displayName: "Use Node.js 22.13 LTS"
      inputs:
        version: '22.13.x'

    - script: npm install -g pnpm@10
      displayName: "Setup pnpm"

    - script: pnpm install
      workingDirectory: CRMnext/Acidaes.BusinessNext.Client/businessnext-js-css/businessnext-monorepo
      displayName: "Install JS Dependencies"

    - script: |
        pnpm run build:all
        exit_code=$?
        if [ $exit_code -ne 0 ]; then
          echo "JS build completed with warnings but no fatal errors."
        fi
        exit 0
      workingDirectory: CRMnext/Acidaes.BusinessNext.Client/businessnext-js-css/businessnext-monorepo
      displayName: "Build JS"

    - script: |
        echo "Cleaning node_modules and pnpm cache to free space..."
        rm -rf node_modules
        pnpm store prune
        df -h
      workingDirectory: CRMnext/Acidaes.BusinessNext.Client/businessnext-js-css/businessnext-monorepo
      displayName: Cleanup After JS Build

    - script: npm install
      workingDirectory: CRMnext/Acidaes.BusinessNext.Client/cssmodules
      displayName: "Install Dart Sass"

    - script: npm run build || echo "SCSS build completed with warnings."
      workingDirectory: CRMnext/Acidaes.BusinessNext.Client/cssmodules
      displayName: "Compile SCSS"

    - script: |
        echo "Disk usage after JS & CSS stage:"
        df -h
      displayName: Final Disk Check JS+CSS
